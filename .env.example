# Copy to .env (or .env.local) and adjust. Only VITE_-prefixed values reach the browser,
# so never put secrets here.

# Backend API base URL (including /api/v1). Defaults to "/api" on the current origin.
VITE_API_BASE_URL=https://api.mypageseo.com/api/v1

# Map tiles for the ranking maps (optional). Defaults to OpenStreetMap, which is for light use;
# use a commercial tile provider in production.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
